# ---------- Servidor ----------
PORT=3001                      # Railway define automaticamente
HOST=0.0.0.0
NODE_ENV=development           # production no Railway
LOG_LEVEL=info                 # debug | info | warn | error

# ---------- Segurança (obrigatório em produção) ----------
# Token do painel /admin. Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Opcional: segredo do HMAC que anonimiza IDs de espectadores (padrão: derivado do ADMIN_TOKEN)
HASH_SECRET=
# Origens extras permitidas além da própria origem do site, separadas por vírgula
ALLOWED_ORIGINS=

# ---------- Banco de dados ----------
# Railway: adicione o plugin PostgreSQL e referencie ${{Postgres.DATABASE_URL}}
DATABASE_URL=
DATABASE_SSL=auto              # auto | true | false
# Só diagnóstico: permite subir em produção sem banco (placar volátil)
ALLOW_EPHEMERAL=false
RETENTION_DAYS=30              # retenção de eventos/combos/seguidores

# ---------- TikTok LIVE ----------
# @ do canal que transmite (sem o @). Também pode ser alterado no painel /admin.
TIKTOK_USERNAME=
TIKTOK_AUTOCONNECT=true        # conecta sozinho ao iniciar (e tenta de novo até a LIVE começar)
# Chave opcional do Euler Stream (assinatura do WebSocket usada pelo tiktok-live-connector).
# Sem chave o conector usa o limite gratuito/compartilhado e pode sofrer 429.
EULER_SIGN_API_KEY=
MAX_LIKES_PER_EVENT=100        # teto de curtidas aceitas em uma única mensagem

# ---------- Sons e bordões ----------
# Sem AUDIO_STORAGE_DIR os arquivos ficam no PostgreSQL (persistem sem volume).
# Com um Volume do Railway montado, ex.: AUDIO_STORAGE_DIR=/data/audio
AUDIO_STORAGE_DIR=
AUDIO_MAX_BYTES=5242880        # 5 MB por arquivo
AUDIO_MAX_CLIPS=200

# ---------- Jogo ----------
# O jogo reage SOMENTE a eventos reais da LIVE. O gerador automático de blocos vem desligado
# e só é ativado pelo operador no painel; AUTOPLAY=off remove a possibilidade por completo.
AUTOPLAY=on
# Botões de simulação do painel. Padrão: desligados em produção, ligados em desenvolvimento.
ENABLE_TEST_EVENTS=false
GIFT_SEED=on                   # aplica 1x o mapeamento inicial de giftIds (server/gift-seed.ts) em slots vazios

# ---------- Frontend em desenvolvimento ----------
CLIENT_ORIGIN=http://localhost:5173
